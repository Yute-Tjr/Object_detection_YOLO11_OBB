[Unit]
Description=Terminal inspection single-GPU inference worker
After=network-online.target postgresql.service terminal-api.service
Wants=network-online.target

[Service]
Type=simple
User=terminal-inspection
Group=terminal-inspection
WorkingDirectory=/opt/terminal-inspection/current
EnvironmentFile=/etc/terminal-inspection/terminal-web.env
ExecStart=/usr/bin/env ${TERMINAL_PYTHON} scripts/run_terminal_worker.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
